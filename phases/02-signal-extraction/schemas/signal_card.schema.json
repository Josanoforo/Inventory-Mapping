{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inventory-mapping.local/schemas/signal_card.schema.json",
  "title": "Signal Card",
  "description": "Canonical schema for one Signal Card produced by Signal Extraction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "signal_id",
    "source_record_ids",
    "source_ids",
    "round",
    "signal_text",
    "subject_exact",
    "actor_level",
    "platforms",
    "product_type_if_explicit",
    "metric_type",
    "metric_value_raw",
    "metric_unit",
    "time_scope_raw",
    "time_scope_normalized_if_safe",
    "geography_if_explicit",
    "evidence_role",
    "local_qualifiers",
    "uncertainties",
    "traceability_pointers",
    "normalization_notes",
    "extraction_notes"
  ],
  "properties": {
    "signal_id": {
      "type": "string",
      "pattern": "^SC-R\\d+-\\d+$",
      "description": "Canonical Signal Card ID"
    },
    "source_record_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Extraction Record IDs used to construct this signal"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Underlying source IDs"
    },
    "round": {
      "type": "integer",
      "minimum": 1,
      "description": "Research or extraction round number"
    },
    "signal_text": {
      "type": "string",
      "minLength": 1,
      "description": "Observationally worded signal text"
    },
    "subject_exact": {
      "type": "string",
      "minLength": 1,
      "description": "Precise local subject preserved from extraction"
    },
    "actor_level": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "buyer",
            "seller",
            "product",
            "marketplace",
            "platform",
            "source",
            "third_party",
            "mixed",
            "unknown"
          ]
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "buyer",
              "seller",
              "product",
              "marketplace",
              "platform",
              "source",
              "third_party",
              "mixed",
              "unknown"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      ]
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Explicit platforms named in the signal"
    },
    "product_type_if_explicit": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "notion_template",
            "ebook",
            "digital_planner",
            "prompt",
            "spreadsheet",
            "csv_database",
            "pattern",
            "design_asset",
            "stock_photo",
            "software",
            "bundle",
            "unknown"
          ]
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "notion_template",
              "ebook",
              "digital_planner",
              "prompt",
              "spreadsheet",
              "csv_database",
              "pattern",
              "design_asset",
              "stock_photo",
              "software",
              "bundle",
              "unknown"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      ]
    },
    "metric_type": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "mag_revenue",
            "mag_profit",
            "mag_payout",
            "mag_fee_rate",
            "mag_traffic_volume",
            "mag_active_buyers",
            "mag_monthly_visitors",
            "mag_sales_count",
            "mag_conversion_rate",
            "mag_review_count",
            "mag_price",
            "mag_time_to_first_sale",
            "mag_rate",
            "mag_volume",
            "mag_count",
            "mag_buyer_count",
            "mag_subscriber_count",
            "mag_share",
            "mag_commission_rate",
            "mag_traffic",
            "mag_discount_rate",
            "qual_search_discovery",
            "qual_first_sale",
            "qual_review_requirement",
            "qual_activation_requirement",
            "qual_payment_method_availability",
            "qual_payout_method_availability",
            "qual_discoverability_claim",
            "qual_refund_policy",
            "unknown"
          ]
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "mag_revenue",
              "mag_profit",
              "mag_payout",
              "mag_fee_rate",
              "mag_traffic_volume",
              "mag_active_buyers",
              "mag_monthly_visitors",
              "mag_sales_count",
              "mag_conversion_rate",
              "mag_review_count",
              "mag_price",
              "mag_time_to_first_sale",
              "mag_rate",
              "mag_volume",
              "mag_count",
              "mag_buyer_count",
              "mag_subscriber_count",
              "mag_share",
              "mag_commission_rate",
              "mag_traffic",
              "mag_discount_rate",
              "qual_search_discovery",
              "qual_first_sale",
              "qual_review_requirement",
              "qual_activation_requirement",
              "qual_payment_method_availability",
              "qual_payout_method_availability",
              "qual_discoverability_claim",
              "qual_refund_policy",
              "unknown"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      ]
    },
    "metric_value_raw": {
      "type": ["string", "number", "null"],
      "description": "Raw metric value as preserved from extraction"
    },
    "metric_unit": {
      "type": ["string", "null"],
      "description": "Raw or minimally normalized metric unit"
    },
    "time_scope_raw": {
      "type": ["string", "null"],
      "description": "Original temporal wording if present"
    },
    "time_scope_normalized_if_safe": {
      "type": ["string", "null"],
      "description": "Normalized time scope only if safely derivable"
    },
    "geography_if_explicit": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_role": {
      "type": "string",
      "enum": [
        "direct_claim",
        "local_context",
        "downstream_consequence",
        "anecdotal_example",
        "official_policy",
        "comparative_commentary",
        "derived_calculation",
        "seller_self_claim",
        "reported_event",
        "database_fact",
        "observed_platform_state",
        "unknown"
      ]
    },
    "local_qualifiers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Local limiting qualifiers preserved in the signal"
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "subject_ambiguity",
          "actor_level_unclear",
          "time_scope_unclear",
          "source_date_unclear",
          "metric_unit_unclear",
          "context_insufficient",
          "checkout_vs_payout_ambiguity",
          "net_vs_gross_ambiguity",
          "current_vs_historical_ambiguity",
          "platform_scope_unclear",
          "product_type_unclear",
          "geography_unclear",
          "methodology_unclear",
          "anecdotal_single_source",
          "author_conflict_of_interest_possible",
          "none"
        ]
      },
      "uniqueItems": true,
      "description": "S40: metric_type_unclear, snippet_needs_reopen, source_type_unclear (pipeline_vocabulary.yaml uncertainties.phase_1_only) are intentionally absent here — this schema is Phase 2, and phase_1_only extensions are out of scope by phase boundary (legitimate narrowing, not desync; see P-162)."
    },
    "traceability_pointers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/traceabilityPointer"
      },
      "description": "Pointers back to source and extraction records"
    },
    "normalization_notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Notes on minimal normalization applied in Signal Extraction"
    },
    "extraction_notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Carryover or local notes from extraction, never strategic interpretation"
    }
  },
  "$defs": {
    "traceabilityPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pointer_type",
        "pointer_value"
      ],
      "properties": {
        "pointer_type": {
          "type": "string",
          "enum": [
            "url",
            "file_path",
            "document_section",
            "line_range",
            "page_reference",
            "anchor",
            "internal_ref",
            "source_record_ref"
          ]
        },
        "pointer_value": {
          "type": "string",
          "minLength": 1
        },
        "secondary_pointer": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
