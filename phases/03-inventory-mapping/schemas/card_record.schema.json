{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CardRecord",
  "description": "One indexed signal card. One line in card_index.jsonl.",
  "type": "object",
  "required": ["id", "round", "observation", "source", "source_type", "domain", "actor", "extraction_status"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SC-R\\d+-\\d+$"
    },
    "round": { "type": "integer", "minimum": 1, "maximum": 10 },
    "observation": { "type": "string", "minLength": 1 },
    "source": { "type": "string" },
    "date": { "type": "string" },
    "source_type": {
      "type": "string",
      "enum": [
        "platform_doc",
        "help_center",
        "pricing_page",
        "policy_page",
        "blog",
        "article",
        "report",
        "news",
        "reddit",
        "seller_forum",
        "buyer_review",
        "product_listing",
        "interview",
        "video_transcript",
        "pdf",
        "database_profile",
        "search_results_page",
        "unknown"
      ]
    },
    "domain": {
      "type": "string",
      "enum": ["market", "platform", "seller", "buyer", "product", "competition", "not_specified"]
    },
    "actor": {
      "type": "string",
      "enum": ["buyer", "seller", "product", "marketplace", "platform", "source", "third_party", "mixed"]
    },
    "evidence_base": { "type": "string" },
    "extraction_status": {
      "type": "string",
      "enum": ["extracted", "ambiguous", "not_extractable"]
    },
    "entities": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Key entities mentioned: platform names, seller names, product types."
    },
    "figures": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Quantitative figures present in the observation."
    }
  }
}
