{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inventory-mapping.local/schemas/data_extraction_record.schema.json",
  "title": "Data Extraction Record",
  "description": "Canonical schema for one extraction record produced by Data Extraction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "extraction_id",
    "source_id",
    "source_type",
    "source_title",
    "source_ref",
    "source_date_if_available",
    "author_or_actor_if_available",
    "snippet_primary",
    "snippet_context_before",
    "snippet_context_after",
    "claim_type",
    "subject_exact",
    "actor_level",
    "platforms",
    "product_type_if_explicit",
    "metric_type",
    "metric_value_raw",
    "metric_unit",
    "time_scope_raw",
    "time_scope_normalized_if_safe",
    "geography_if_explicit",
    "evidence_role",
    "local_qualifiers",
    "uncertainties",
    "parser_notes",
    "traceability_pointer"
  ],
  "properties": {
    "extraction_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique ID for the extraction record"
    },
    "source_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique ID for the source document or page"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "platform_doc",
        "help_center",
        "blog",
        "article",
        "reddit",
        "seller_forum",
        "buyer_review",
        "marketplace_listing",
        "interview",
        "pricing_page",
        "policy_page",
        "pdf",
        "video_transcript",
        "unknown"
      ]
    },
    "source_title": {
      "type": "string",
      "minLength": 1
    },
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "description": "URL, file path, document ref, or stable internal source reference"
    },
    "source_date_if_available": {
      "type": ["string", "null"],
      "description": "Original date string if available"
    },
    "author_or_actor_if_available": {
      "type": ["string", "null"],
      "description": "Author, seller, reviewer, platform, or speaker if available"
    },
    "snippet_primary": {
      "type": "string",
      "minLength": 1,
      "description": "Primary local claim snippet"
    },
    "snippet_context_before": {
      "type": ["string", "null"],
      "description": "Minimal context before the primary snippet"
    },
    "snippet_context_after": {
      "type": ["string", "null"],
      "description": "Minimal context after the primary snippet"
    },
    "claim_type": {
      "type": "string",
      "enum": [
        "explicit_claim",
        "policy_statement",
        "pricing_statement",
        "anecdotal_report",
        "derived_calculation",
        "comparative_commentary",
        "review_statement",
        "availability_statement",
        "instructional_statement",
        "unknown"
      ]
    },
    "subject_exact": {
      "type": "string",
      "minLength": 1,
      "description": "Local, precise subject of the claim"
    },
    "actor_level": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "buyer",
            "seller",
            "product",
            "marketplace",
            "source",
            "mixed",
            "unknown"
          ]
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "buyer",
              "seller",
              "product",
              "marketplace",
              "source",
              "mixed",
              "unknown"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      ],
      "description": "Primary actor level or levels present in the claim"
    },
    "platforms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Explicit platforms mentioned in the local claim"
    },
    "product_type_if_explicit": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "notion_template",
            "ebook",
            "digital_planner",
            "prompt",
            "spreadsheet",
            "csv_database",
            "pattern",
            "design_asset",
            "stock_photo",
            "software",
            "bundle",
            "unknown"
          ]
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "notion_template",
              "ebook",
              "digital_planner",
              "prompt",
              "spreadsheet",
              "csv_database",
              "pattern",
              "design_asset",
              "stock_photo",
              "software",
              "bundle",
              "unknown"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      ]
    },
    "metric_type": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "revenue",
            "profit",
            "payout",
            "fee_rate",
            "traffic_volume",
            "active_buyers",
            "monthly_visitors",
            "search_discovery",
            "sales_count",
            "first_sale",
            "review_requirement",
            "activation_requirement",
            "payment_method_availability",
            "payout_method_availability",
            "discoverability_claim",
            "conversion_rate",
            "refund_policy",
            "review_count",
            "price",
            "time_to_first_sale",
            "unknown"
          ]
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "revenue",
              "profit",
              "payout",
              "fee_rate",
              "traffic_volume",
              "active_buyers",
              "monthly_visitors",
              "search_discovery",
              "sales_count",
              "first_sale",
              "review_requirement",
              "activation_requirement",
              "payment_method_availability",
              "payout_method_availability",
              "discoverability_claim",
              "conversion_rate",
              "refund_policy",
              "review_count",
              "price",
              "time_to_first_sale",
              "unknown"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      ]
    },
    "metric_value_raw": {
      "type": ["string", "number", "null"],
      "description": "Original metric value if present"
    },
    "metric_unit": {
      "type": ["string", "null"],
      "description": "Unit of the metric value, such as USD, percent, buyers, visitors, sales"
    },
    "time_scope_raw": {
      "type": ["string", "null"],
      "description": "Original temporal wording if present"
    },
    "time_scope_normalized_if_safe": {
      "type": ["string", "null"],
      "description": "Normalized time scope only if safely derivable"
    },
    "geography_if_explicit": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_role": {
      "type": "string",
      "enum": [
        "direct_claim",
        "local_context",
        "downstream_consequence",
        "anecdotal_example",
        "official_policy",
        "comparative_commentary",
        "derived_calculation",
        "unknown"
      ]
    },
    "local_qualifiers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Limiting or conditioning qualifiers preserved from the local source"
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "subject_ambiguity",
          "actor_level_unclear",
          "time_scope_unclear",
          "source_date_unclear",
          "metric_unit_unclear",
          "context_insufficient",
          "checkout_vs_payout_ambiguity",
          "net_vs_gross_ambiguity",
          "current_vs_historical_ambiguity",
          "platform_scope_unclear",
          "product_type_unclear",
          "geography_unclear",
          "none"
        ]
      },
      "uniqueItems": true
    },
    "parser_notes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Implementation or parsing notes. Never strategic interpretation."
    },
    "traceability_pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pointer_type",
        "pointer_value"
      ],
      "properties": {
        "pointer_type": {
          "type": "string",
          "enum": [
            "url",
            "file_path",
            "document_section",
            "line_range",
            "page_reference",
            "anchor",
            "internal_ref"
          ]
        },
        "pointer_value": {
          "type": "string",
          "minLength": 1
        },
        "secondary_pointer": {
          "type": ["string", "null"]
        }
      }
    }
  }
}
