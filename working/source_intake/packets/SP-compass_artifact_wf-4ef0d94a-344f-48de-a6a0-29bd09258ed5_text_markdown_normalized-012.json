    {
      "snippet_id": "SNP-001",
      "snippet_text": "\"If the user you referred makes a first-time purchase during that 30-day period, you'll get a 40% commission over the total sale.\"",
      "context_before": null,
      "context_after": null,
      "location_pointer": {
        "pointer_type": "url",
        "pointer_value": "https://www.domestika.org/en/affiliates"
      }
    },
    {
      "snippet_id": "SNP-002",
      "snippet_text": "\"If it's a recurring purchase, you'll get a 20% commission.\"",
      "context_before": null,
      "context_after": null,
      "location_pointer": {
        "pointer_type": "url",
        "pointer_value": "https://www.domestika.org/en/affiliates"
      }
    },
    {
      "snippet_id": "SNP-003",
      "snippet_text": "\"If they sign up for Domestika but don't make a purchase, you'll get US$ 2.00 for each user you've referred.\"",
      "context_before": null,
      "context_after": null,
      "location_pointer": {
        "pointer_type": "url",
        "pointer_value": "https://www.domestika.org/en/affiliates"
      }
    },
    {
      "snippet_id": "SNP-004",
      "snippet_text": "\"When a user clicks on your promotional URL, a cookie programmed to expire in 30 days is set in their browser, allowing Domestika to track all your referral activity.\"",
      "context_before": null,
      "context_after": null,
      "location_pointer": {
        "pointer_type": "url",
        "pointer_value": "https://www.domestika.org/en/affiliates"
      }
    },
    {
      "snippet_id": "SNP-005",
      "snippet_text": "\"Every month, the sales and sign-ups made through your affiliate URLs will be calculated, and you'll get paid in dollars (USD) via PayPal.\"",
      "context_before": null,
      "context_after": null,
      "location_pointer": {
        "pointer_type": "url",
