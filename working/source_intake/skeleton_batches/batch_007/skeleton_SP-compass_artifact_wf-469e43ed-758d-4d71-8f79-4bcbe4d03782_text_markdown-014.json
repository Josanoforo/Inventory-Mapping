      "finding_part": 1
    },
    {
      "snippet_id": "SNP-002",
      "snippet_text": "\"Lemon Squeezy will still charge a flat fee of $0.50 for U.S. payouts sent through Paypal, and 3% (up to $30) for international accounts.\"",
