    {
      "snippet_id": "SNP-001",
      "snippet_text": "\"If you accept payments through Etsy Payments, we also collect a 4% + €0.30 payment processing fee when an item is sold.\" (EU version; UK rate confirmed separately as 4% + £0.20)",
      "context_before": null,
      "context_after": null,
      "location_pointer": {
        "pointer_type": "url",
        "pointer_value": "https://help.etsy.com/hc/en-us/articles/115015628847-What-are-Payment-Processing-Fees-for-Selling-on-Etsy"
      },
      "source_finding_id": "F-06",
      "finding_part": 1
    },
    {
      "snippet_id": "SNP-002",
      "snippet_text": "\"If you issue a refund for a sale made through Etsy Payments, your payment processing fee will be credited proportionally and applied to the refund amount.\"",
      "context_before": null,
      "context_after": null,
      "location_pointer": {
        "pointer_type": "url",
        "pointer_value": "https://help.etsy.com/hc/en-us/articles/115015628847-What-are-Payment-Processing-Fees-for-Selling-on-Etsy"
      },
      "source_finding_id": "F-08",
      "finding_part": 1
    },
    {
      "snippet_id": "SNP-003",
      "snippet_text": "\"Note: Etsy Payments processing fees are subject to VAT. VAT will be collected and appear on the VAT invoice for sellers in required locations.\"",
      "context_before": null,
      "context_after": null,
      "location_pointer": {
        "pointer_type": "url",
        "pointer_value": "https://help.etsy.com/hc/en-us/articles/115015628847-What-are-Payment-Processing-Fees-for-Selling-on-Etsy"
      },
      "source_finding_id": "F-44",
      "finding_part": 1
    },
    {
      "snippet_id": "SNP-004",
      "snippet_text": "\"Payment processing fees are a set rate plus a percent of the total sale price of the item. This rate and percent vary by country.\"",
