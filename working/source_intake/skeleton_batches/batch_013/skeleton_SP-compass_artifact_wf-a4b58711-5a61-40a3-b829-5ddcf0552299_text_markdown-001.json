  "snippets": [
    {
      "snippet_id": "SNP-001",
      "snippet_text": "\"You're on the Founders plan if you joined Patreon before May 7, 2019, and haven't upgraded your plan in the past, changed your currency, or had your creator page unpublished by you or by Patreon for any reason.\"",
      "context_before": null,
      "context_after": null,
      "location_pointer": {
        "pointer_type": "url",
        "pointer_value": "https://support.patreon.com/hc/en-us/articles/11111747095181-Creator-fees-overview"
      },
      "source_finding_id": "F-P04",
      "finding_part": 2
    },
    {
      "snippet_id": "SNP-002",
      "snippet_text": "[Stated in layout: \"Payment processing fee Varies by currency (e.g., 2.9% + $0.30 USD) standard payment process rate\"]",
      "context_before": null,
      "context_after": null,
      "location_pointer": {
        "pointer_type": "url",
        "pointer_value": "https://support.patreon.com/hc/en-us/articles/11111747095181-Creator-fees-overview"
      },
      "source_finding_id": "F-P05",
      "finding_part": 2
    },
    {
      "snippet_id": "SNP-003",
      "snippet_text": "\"A 2.5% currency conversion fee applies when a fan pays in a currency that's different from your payout currency. This fee is calculated on the full processed amount, including tax\"",
      "context_before": null,
      "context_after": null,
      "location_pointer": {
        "pointer_type": "url",
        "pointer_value": "https://support.patreon.com/hc/en-us/articles/11111747095181-Creator-fees-overview"
      },
      "source_finding_id": "F-P06",
      "finding_part": 2
    },
    {
      "snippet_id": "SNP-004",
      "snippet_text": "\"If a paid member pays you in your payout currency, then there is no currency conversion fee applied.\"",
      "context_before": null,
      "context_after": null,
      "location_pointer": {
        "pointer_type": "url",
        "pointer_value": "https://support.patreon.com/hc/en-us/articles/11111747095181-Creator-fees-overview"
      },
      "source_finding_id": "F-P07",
      "finding_part": 2
    },
    {
      "snippet_id": "SNP-005",
      "snippet_text": "\"The platform fee covers the use of Patreon's platform and is a percentage of successfully processed membership and one-time purchases. We calculate your platform fee based on the payment amount, excluding sales tax.\"",
      "context_before": null,
      "context_after": null,
      "location_pointer": {
        "pointer_type": "url",
        "pointer_value": "https://support.patreon.com/hc/en-us/articles/11111747095181-Creator-fees-overview"
      },
      "source_finding_id": "F-P11",
      "finding_part": 2
    },
    {
      "snippet_id": "SNP-006",
      "snippet_text": "\"Founders who have changed their payout currency remain on the Founders plan and retain their 5% platform fee, but are subject to the standard processing rates below rather than the Founders processing rates.\"",
      "context_before": null,
      "context_after": null,
      "location_pointer": {
        "pointer_type": "url",
        "pointer_value": "https://support.patreon.com/hc/en-us/articles/11111747095181-Creator-fees-overview"
