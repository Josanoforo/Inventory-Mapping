    {
      "snippet_id": "SNP-002",
      "snippet_text": "\"Likewise in places like Argentina, there's a monthly limit for transactions in dollars. If you reach this limit and attempt to complete a new purchase, the payment will be rejected.\"",
      "context_before": null,
      "context_after": null,
      "location_pointer": {
