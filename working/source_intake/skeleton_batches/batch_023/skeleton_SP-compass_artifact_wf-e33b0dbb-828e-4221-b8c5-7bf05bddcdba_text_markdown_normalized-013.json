    },
    {
      "snippet_id": "SNP-002",
      "snippet_text": "> \"The standard Square fee for online credit card transactions is 2.8% + $0.30 per transaction. Please check Square's pricing page for the latest updates. There are no chargeback fees. Note that these fees are collected by Square and do not go to Payhip.\"",
      "context_before": null,
      "context_after": null,
